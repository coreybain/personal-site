{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [".env"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // NEXT_PUBLIC_ variables are inlined into the client bundle at build time,
      // so their values are part of the build's identity. Declaring them here is
      // what stops Turbo replaying a cached build that baked in the old Convex
      // deployment or Clerk instance. Server-only secrets (CLERK_SECRET_KEY) are
      // deliberately absent: they are read at runtime, so listing them would
      // invalidate the cache for no reason.
      "env": ["NEXT_PUBLIC_CONVEX_URL", "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY"],
      // The `env` key above only covers variables Turbo can see in its own
      // process. Locally they arrive from `apps/web/.env.local`, which Next
      // loads itself long after Turbo has computed the hash — so without this,
      // editing `.env.local` would replay a cached build with the previous
      // Convex URL baked into the client bundle. `$TURBO_DEFAULT$` keeps the
      // normal source-file inputs; the two patterns add the env files, resolved
      // per package (so apps/web's, not the repo root's).
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    // packages/convex's `codegen` script. Declared so `turbo run codegen`
    // resolves from the root rather than erroring, and uncached because it
    // writes into the source tree (`convex/_generated`) and needs a configured,
    // reachable deployment — a cache replay can honour neither.
    //
    // Deliberately nothing `dependsOn` it. Making `typecheck` or `build` wait on
    // codegen would make both unrunnable on a checkout with no Convex project,
    // which is exactly why `convex/_generated` is committed instead. See
    // packages/convex/README.md.
    "codegen": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
