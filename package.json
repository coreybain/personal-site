{
  "name": "home",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/perf"
  ],
  "scripts": {
    "build": "bun --env-file=.env run turbo run build",
    "dev": "bun --env-file=.env run turbo run dev",
    "lint": "bun --env-file=.env run turbo run lint",
    "test": "bun --env-file=.env run turbo run test",
    "typecheck": "bun --env-file=.env run turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
