# dependencies
node_modules/
.pnp
.pnp.*

# builds
.next/
out/
build/
dist/

# turbo
.turbo/

# env
.env
.env.*
!.env.example

# convex
# Local CLI state only. `packages/convex/.env.local` (CONVEX_DEPLOYMENT) is
# already covered by the env rules above.
#
# NOTE: packages/convex/convex/_generated/ is deliberately NOT ignored — apps/web
# imports it (@home/convex/api), so it is committed and refreshed with
# `bun run codegen` in packages/convex.
.convex/

# collector
# The repo→slug mapping is machine-local AND private: the left-hand side of
# every entry is a private repository's checkout directory name, and ADR 008
# says those never leave this Mac. `personal-site` is a public repo, so
# committing the mapping would publish the inventory the collector's own privacy
# funnel exists to withhold. `collector.config.example.json` is committed in its
# place; copy it and edit.
tooling/collector/collector.config.json

# git repo map
# The repo→display-name mapping for the heatmap's day popup. Same reasoning as
# the collector config above, one step more sensitive: the left-hand side of
# every entry is a GitHub `owner/name` for a PRIVATE repository, which is the
# exact shape ADR 008 forbids unconditionally (a bare product name may be
# published once a case study is; an `owner/name` identifier never may be).
# `git-repo-map.example.json` is committed in its place and every repository
# name in it is invented. See tooling/git-repo-map/README.md.
tooling/git-repo-map/git-repo-map.json

# lighthouse ci
# Run output: one JSON + one HTML report per URL per run. The HTML reports embed
# full-page screenshots of an unlaunched site (ADR 018 keeps the preview
# noindex), so they are build artefacts, never commits. CI uploads them to the
# workflow run instead, where they expire.
.lighthouseci/

# ios
# Which backend the phone talks to. Written by apps/ios/scripts/seed-config.sh
# from the two NEXT_PUBLIC_* values in this repo's .env, and gitignored for the
# same reason .env itself is: it is *environment*, not secret. Committing it
# would mean a production build silently pointed at dev:hip-dragon-50 until
# somebody remembered to edit a tracked file — a failure whose symptom is wrong
# rows in the wrong database, and which nothing would surface.
# apps/ios/Config/Config.local.example.plist is committed in its place.
#
# Note what is NOT here: Home.xcodeproj is deliberately COMMITTED even though
# XcodeGen generates it, so that CI and a fresh clone can build without a
# Homebrew install first. See apps/ios/README.md.
apps/ios/Config/Config.local.plist

# Xcode per-user and per-machine state. `xcuserdata` holds window positions,
# breakpoints and autocreated schemes — which is why apps/ios/project.yml
# declares the Home scheme explicitly, so the shared copy under xcshareddata is
# the one `xcodebuild -scheme Home` finds.
**/xcuserdata/
**/*.xcuserdatad
apps/ios/DerivedData/
apps/ios/build/
# SwiftPM's local resolution cache and checkouts (the convex-swift xcframework
# alone is 147 MB). Package.resolved under xcshareddata/swiftpm IS tracked.
.swiftpm/xcode/package.workspace/
**/.swiftpm/configuration/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# os / editor
.DS_Store
*.pem
.vscode/*
!.vscode/extensions.json
.idea/

# testing / misc
coverage/
next-env.d.ts
*.tsbuildinfo
