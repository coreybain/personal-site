{
  "name": "@home/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local MCP adapter for the authenticated Home management gateway.",
  "bin": {
    "home-management-mcp": "./dist/stdio.js"
  },
  "scripts": {
