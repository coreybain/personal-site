  },
  "engines": {
    "node": ">=20.3.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@uploadfile/core": "0.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/node": "^20",
    "typescript": "^5.9.3"
  }
}
