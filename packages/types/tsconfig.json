{
  "compilerOptions": {
    /* This is a just-in-time TypeScript package: `exports` points straight at
     * ./src/*.ts and there is no build step, so the only job of this config is
     * to typecheck the source. Nothing is ever emitted. */
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Consumers bundle this source directly, so imports must survive
     * transpilation unchanged and type-only imports must be explicit. */
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "noEmit": true,
    "declaration": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
