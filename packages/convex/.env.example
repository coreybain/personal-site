# packages/convex/.env.local — machine-local Convex CLI config. Never committed.
#
# `bunx convex dev` writes CONVEX_DEPLOYMENT itself on first run; you do not set
# it by hand. Everything a Convex *function* reads at runtime (CLERK_JWT_ISSUER_DOMAIN,
# GITHUB_TOKEN, …) lives in the Convex dashboard instead — functions never see
# this file. See README.md.

# Written by `bunx convex dev`. Identifies the deployment the CLI pushes to.
CONVEX_DEPLOYMENT=dev:your-deployment-name

# Documentation only — auth.config.ts reads this from the Convex deployment
# environment, not from here. Kept so a checkout records which Clerk instance
# it is pointed at.
CLERK_JWT_ISSUER_DOMAIN=https://verb-noun-00.clerk.accounts.dev
