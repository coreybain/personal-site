{
  "name": "@home/pdf",
  "version": "0.0.0",
  "private": true,
  "description": "The PDF résumé document (ADR 011). @react-pdf/renderer, rendered server-side from the same Resume Document apps/web's /resume page renders.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./assets/*": "./assets/*"
  },
  "sideEffects": false,
  "files": ["src", "assets"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "render-fixture": "bun run scripts/render-fixture.ts",
    "orphan-sweep": "bun run scripts/orphan-sweep.ts"
  },
  "dependencies": {
    "@home/types": "workspace:*",
    "@react-pdf/renderer": "^4.5.1",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "typescript": "^5.9.3"
  }
}
